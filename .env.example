# SMDApp Environment Configuration
# Copy to .env and fill in real values
# NEVER commit .env to Git

# Database
DATABASE_URL=file:./db/custom.db

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# ICICI Breeze
BREEZE_APP_KEY=
BREEZE_SECRET_KEY=
BREEZE_SESSION_TOKEN=
BREEZE_USERNAME=
BREEZE_PASSWORD=

# Motilal Oswal
MOTILAL_API_KEY=
MOTILAL_SECRET_KEY=
MOTILAL_VENDOR_ID=
MOTILAL_USERID=
MOTILAL_PASSWORD=
MOTILAL_DOB=
MOTILAL_PRIMARY_IP=
MOTILAL_SECONDARY_IP=
MOTILAL_TOTP_KEY=

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_CHAT_IDS=
TELEGRAM_ALLOW_OFFHOURS=0

# LLM APIs
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Auth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Internal Services
NEXT_PUBLIC_TRADE_AUDIT_URL=http://localhost:4001
NEXT_PUBLIC_MARKET_HISTORY_URL=http://localhost:4002
NEXT_PUBLIC_BASE_URL=http://localhost:3000
