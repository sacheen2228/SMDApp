# SMDApp Environment Configuration
# Copy to .env and fill in real values
# NEVER commit .env to Git

# Database
DATABASE_URL=file:./db/custom.db

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# ICICI Breeze
BREEZE_APP_KEY=
BREEZE_SECRET_KEY=
BREEZE_SESSION_TOKEN=
BREEZE_USERNAME=
BREEZE_PASSWORD=

# Motilal Oswal
MOTILAL_API_KEY=
MOTILAL_SECRET_KEY=
MOTILAL_VENDOR_ID=
MOTILAL_USERID=
MOTILAL_PASSWORD=
MOTILAL_DOB=
MOTILAL_PRIMARY_IP=
MOTILAL_SECONDARY_IP=
MOTILAL_TOTP_KEY=

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_CHAT_IDS=
TELEGRAM_ALLOW_OFFHOURS=0

# LLM APIs — Provider chain (TokenRa → Groq → OpenRouter → Ollama)
# TokenRa (primary paid provider)
TOKENRA_API_KEY=
TOKENRA_BASE_URL=https://tokenra.io/v1
TOKENRA_CHAT_ENDPOINT=https://tokenra.io/v1/chat/completions
TOKENRA_MODEL=deepseek-v4.1-flash
TOKENRA_FALLBACK_MODELS=deepseek-v4-flash,qwen3.8-flash
TOKENRA_TIMEOUT=30000

# Groq (fast free provider)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound-mini
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,groq/compound
GROQ_TIMEOUT=15000

# OpenRouter (fallback free models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT=20000

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=60000

# Legacy keys (kept for backward compatibility)
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Auth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Internal Services
NEXT_PUBLIC_TRADE_AUDIT_URL=http://localhost:4001
NEXT_PUBLIC_MARKET_HISTORY_URL=http://localhost:4002
NEXT_PUBLIC_BASE_URL=http://localhost:3000
