generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PREMIUM
  FREE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trade {
  id               String   @id @default(cuid())
  tradeId          String   @unique
  symbol           String
  exchange         String   @default("NSE")
  strike           Float
  type             String
  side             String   @default("BUY")
  entryTime        DateTime
  entryPrice       Float
  exitTime         DateTime?
  exitPrice        Float?
  pnl              Float?
  pnlPercent       Float?
  holdingTimeMin   Float?
  confidence       Float
  qualityScore     Float
  qualityGrade     String
  aiReasonSnapshot String
  exitReason       String?
  status           String   @default("OPEN")
  riskPerTrade     Float
  positionSize     Float
  stopLoss         Float
  target1          Float?
  target2          Float?
  target3          Float?
  tpHitLevel       String?
  strategy         String   @default("intraday-scan")
  tradedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
}

model DomAnalysis {
  id                String   @id @default(cuid())
  symbol            String
  date              DateTime
  spot              Float
  atmStrike         Float
  pcr               Float
  maxPain           Float
  expiry            String
  timestamp         DateTime
  strikes           Json
  unusualBuildup    Json
  resistance        Json
  support           Json
  createdAt         DateTime @default(now())

  @@unique([symbol, date], name: "symbol_date")
}

model ParticipantOI {
  id                  Int      @id @default(autoincrement())
  date                String
  participant         String
  futureIndexLong     Int
  futureIndexShort    Int
  futureStockLong     Int
  futureStockShort    Int
  optionIndexCallLong  Int
  optionIndexCallShort Int
  optionIndexPutLong   Int
  optionIndexPutShort  Int
  optionStockCallLong  Int
  optionStockCallShort Int
  optionStockPutLong   Int
  optionStockPutShort  Int
  totalLong           Int
  totalShort          Int
  createdAt           DateTime @default(now())

  @@unique([date, participant])
  @@index([date])
  @@index([participant])
}

// ── Broker Configuration (encrypted credentials) ──
model BrokerConfig {
  id                String   @id @default(cuid())
  broker            String   // "ICICI_BREEZE" | "MOTILAL"
  credentials       String   // AES-256-GCM encrypted JSON
  iv                String   // encryption IV
  tag               String   // auth tag for GCM
  status            String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED | CONNECTED | DISCONNECTED | AUTH_ERROR
  lastConnectedAt   DateTime?
  lastError         String?
  connectionState   String   @default("NOT_CONFIGURED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([broker])
}

// ── Central Trade Ledger (single source of truth) ──
model CentralTrade {
  id                String   @id @default(cuid())
  tradeId           String   @unique
  symbol            String
  exchange          String   @default("NSE")
  instrument        String   @default("equity") // equity | index_fo | stock_fo | options | mcx
  strike            Float?
  optionType        String?  // CE | PE
  expiry            String?
  direction         String   // BUY | SELL
  strategy          String
  strategyProfile   String   // EQUITY_SWING | FO | OPTIONS | CAS | HERO_ZERO | MCX_COMMODITY
  scoringVersion    String   @default("v2.0")
  entryPrice        Float
  stopLoss          Float
  target1           Float?
  target2           Float?
  target3           Float?
  riskReward        Float?
  quantity          Int
  riskPerTrade      Float
  positionCost      Float
  maxLoss           Float
  score             Float
  scoreBreakdown    Json     // frozen score at entry
  hardGateStatus    Json     // frozen hard gate status at entry
  marketRegime      String?
  entryReason       String?
  entryTime         DateTime
  exitPrice         Float?
  exitTime          DateTime?
  exitReason        String?
  pnl               Float?
  pnlPercent        Float?
  charges           Float?
  slippage          Float?
  holdingPeriodMin  Float?
  status            String   @default("OPEN") // OPEN | CLOSED | EXPIRED | CANCELLED
  source            String   @default("paper") // paper | live | backtest
  isDuplicate       Boolean  @default(false)
  signalCreatedAt   DateTime?
  signalExpiresAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([symbol])
  @@index([strategy])
  @@index([status])
  @@index([entryTime])
}

// ── User Settings ──
model UserSettings {
  id                String   @id @default(cuid())
  key               String   @unique
  value             Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
